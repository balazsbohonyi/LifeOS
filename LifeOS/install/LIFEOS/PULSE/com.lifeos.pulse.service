[Unit]
Description=LifeOS Pulse — unified daemon (cron, voice, observability, hooks)
After=network.target

[Service]
Type=simple
ExecStart=__EXEC_START_SYSTEMD__
WorkingDirectory=__WORKING_DIRECTORY_SYSTEMD__
Restart=on-failure
RestartSec=30
TimeoutStopSec=5
Environment=__ENV_HOME_SYSTEMD__
Environment=__ENV_CONFIG_ROOT_SYSTEMD__
Environment=__ENV_LIFEOS_DIR_SYSTEMD__
Environment=__ENV_LIFEOS_CONFIG_PATH_SYSTEMD__
Environment=__ENV_PULSE_DIR_SYSTEMD__
Environment=__ENV_PATH_SYSTEMD__
StandardOutput=__STDOUT_SYSTEMD__
StandardError=__STDERR_SYSTEMD__

[Install]
WantedBy=default.target
